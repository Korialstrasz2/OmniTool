  {"schema_version":1,"id":"media-passive-capture","name":"Passive Media Capture","description":"Run the existing passive capture script as a tracked job. Capture only content you are authorized to use.","folder":"Media / Downloads","kind":"python","requires":["requests","playwright"],"risk":"writes-files","parameters":[{"name":"url","label":"Authorized player page URL","type":"text","required":true,"flag":"--url"},{"name":"output","label":"Output directory","type":"path","required":true,"flag":"--output"},{"name":"mode","label":"Mode","type":"choice","choices":["slow","fast","elusive-sites"],"default":"slow","flag":"--mode"},{"name":"capture-seconds","label":"Capture Seconds","type":"integer","default":90,"min":20,"max":600,"flag":"--capture-seconds"},{"name":"idle-seconds","label":"Idle Seconds","type":"integer","default":12,"min":3,"max":120,"flag":"--idle-seconds"},{"name":"parallel-downloads","label":"Parallel Downloads","type":"integer","default":3,"min":1,"max":12,"flag":"--parallel-downloads"},{"name":"headless","label":"Run browser headless","type":"boolean","default":true,"flag":"--headless"},{"name":"auto-download","label":"Download captured streams","type":"boolean","default":false,"flag":"--auto-download"}],"review_note":"Promoted from a hidden supporting script to a catalog entry. Browser binaries and download backends require local setup.","entrypoint":"scripts/media_passive_capture.py","working_directory":"scripts"}
