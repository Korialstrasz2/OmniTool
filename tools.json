  {"schema_version":1,"id":"lyrics-embedder-manager","name":"Lyrics Embedder","description":"Fetch provider lyrics and embed audio tags. Optional paid AI recovery is off by default.","folder":"Media / Metadata","kind":"python","requires":["mutagen","requests"],"risk":"writes-files","parameters":[{"name":"root","label":"Music folder","type":"path","required":true},{"name":"workers","label":"Workers","type":"integer","default":4,"min":1,"max":32,"flag":"--workers"},{"name":"min-delay","label":"Minimum provider delay (seconds)","type":"text","default":"0.5","flag":"--min-delay"},{"name":"timeout","label":"Request timeout (seconds)","type":"text","default":"20","flag":"--timeout"},{"name":"retries","label":"Retries","type":"integer","default":2,"min":0,"max":10,"flag":"--retries"},{"name":"max-files","label":"Maximum files (0 = all)","type":"integer","default":0,"min":0,"flag":"--max-files"},{"name":"force","label":"Replace existing lyrics","type":"boolean","default":false,"flag":"--force"},{"name":"keep-synced","label":"Keep synchronized lyrics","type":"boolean","default":false,"flag":"--keep-synced"},{"name":"ai-if-failed","label":"Allow paid AI metadata recovery","type":"boolean","default":false,"flag":"--ai-if-failed"},{"name":"ai-model","label":"AI model ID (only when enabled)","type":"text","flag":"--ai-model"},{"name":"ai-rounds","label":"Ai Rounds","type":"integer","default":2,"min":1,"max":5,"flag":"--ai-rounds"},{"name":"exts","label":"Audio extensions","type":"text","default":".mp3,.flac,.m4a,.mp4,.aac,.ogg,.opus","flag":"--exts"},{"name":"log-level","label":"Log Level","type":"choice","choices":["INFO","WARNING","ERROR","DEBUG"],"default":"INFO","flag":"--log-level"}],"review_note":"Existing provider logic is retained. Provider health, tag backups, and rate limits still need integration testing. Advanced flags remain available in the script CLI.","entrypoint":"scripts/lyrics_embedder.py","working_directory":"scripts"},
