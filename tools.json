  {"schema_version":1,"id":"media-harvester-manager","name":"Media Harvester","description":"Preview or download media you are authorized to access, with structured controls and tracked jobs.","folder":"Media / Downloads","kind":"python","requires":["requests"],"risk":"writes-files","parameters":[{"name":"url","label":"Media page URL","type":"text","required":true},{"name":"output","label":"Output directory","type":"path","required":true,"flag":"--output"},{"name":"preview-only","label":"Preview only (recommended)","type":"boolean","default":true,"flag":"--preview-only"},{"name":"workers","label":"Workers","type":"integer","default":4,"min":1,"max":16,"flag":"--workers"},{"name":"timeout","label":"Network timeout (seconds)","type":"text","default":"45","flag":"--timeout"},{"name":"include-page-with-ytdlp","label":"Include page with yt-dlp","type":"boolean","default":false,"flag":"--include-page-with-ytdlp"},{"name":"download-all-resolutions","label":"Download all resolutions","type":"boolean","default":false,"flag":"--download-all-resolutions"},{"name":"extract-audio-mp3","label":"Extract MP3 audio","type":"boolean","default":false,"flag":"--extract-audio-mp3"},{"name":"all-page","label":"Inspect all page sources","type":"boolean","default":false,"flag":"--all-page"},{"name":"all-scroll","label":"Scroll page with Playwright","type":"boolean","default":false,"flag":"--all-scroll"},{"name":"access-strategy","label":"Access Strategy","type":"choice","choices":["standard","resilient"],"default":"standard","flag":"--access-strategy"},{"name":"site-mode","label":"Site Mode","type":"choice","choices":["general","instagram-public","all-media-html-sources"],"default":"general","flag":"--site-mode"},{"name":"proxy","label":"Optional proxy URL","type":"text","flag":"--proxy"},{"name":"diagnostics","label":"Verbose diagnostics may contain URLs","type":"boolean","default":false,"flag":"--diagnostics"}],"review_note":"Preview is the default. Install optional yt-dlp/Playwright and